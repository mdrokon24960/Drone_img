# ── Server ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
DB_PATH=droneseg.db

# ── Model ────────────────────────────────────────────────────────────────────
MODEL_ID=nvidia/segformer-b2-finetuned-ade-512-512
MAX_UPLOAD_SIZE_MB=50

# ── OpenAI — required only for LLM vision mode ───────────────────────────────
OPENAI_API_KEY=sk-...

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
